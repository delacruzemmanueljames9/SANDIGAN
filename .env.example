# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SUPABASE POSTGRESQL & AUTHENTICATION
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# SUPABASE SERVICE ROLE KEY (Server-side ONLY - NEVER expose to browser)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your-service-role-secret-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# GOOGLE GEMINI API (Server-side ONLY)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# BACKGROUND WORKER & SCHEDULER
WORKER_AUTH_TOKEN=generate-a-secure-random-token-here
CRON_SECRET=generate-a-secure-cron-secret-here

# SECURITY & RATE LIMITING
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# OPTIONAL INTEGRATIONS (Phase 5+)
# RESEND_API_KEY=your-resend-api-key-here
# WHATSAPP_API_TOKEN=your-whatsapp-token-here
